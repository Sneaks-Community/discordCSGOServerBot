# -----------------------------------------------------------------------------
# REQUIRED - Discord Bot Configuration
# -----------------------------------------------------------------------------

# Your Discord bot token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# The one guild this instance serves. Slash commands are registered there, and the
# bot leaves any other guild it is added to.
DISCORD_GUILD_ID=123456789012345678

# Discord role ID with admin access (optional - leave empty to disable admin commands)
# Get your Discord role ID by right-clicking the role in server settings
ADMIN_ROLE_ID=123456789012345678

# -----------------------------------------------------------------------------
# OPTIONAL - Presence (the status shown under the bot's name)
# -----------------------------------------------------------------------------

# Activity text, up to 128 characters. Leave blank to show no activity at all.
# Mention a channel by name here only if your guild actually restricts commands
# to one; the default deliberately does not.
BOT_ACTIVITY_TEXT=/follow <map> for map change alerts

# How the text renders, one of: custom, playing, listening, watching, competing.
# custom (the default) shows the text verbatim; the others have their verb
# prepended by Discord ("Playing ...", "Listening to ...").
BOT_ACTIVITY_TYPE=custom

# -----------------------------------------------------------------------------
# OPTIONAL - Logging Configuration
# -----------------------------------------------------------------------------

# All logs go to stdout. Verbosity, one of: trace, debug, info, warn, error, fatal, silent.
# Defaults to info, so debug and trace output is suppressed unless set here.
# An unrecognized value falls back to info and logs a warning at startup.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - Fallback Notification Configuration
# -----------------------------------------------------------------------------

# Channel used when a DM cannot be delivered, in DISCORD_GUILD_ID like every other
# channel the bot uses. Leave empty to disable fallback notifications.
FALLBACK_CHANNEL_ID=123456789012345678

# -----------------------------------------------------------------------------
# OPTIONAL - Embed Configuration
# -----------------------------------------------------------------------------

# JSON array of embed configurations for server status messages
# Format: [{"channelID": "xxx", "messageID": "yyy"}]
# Leave empty to disable embed updates
EMBEDS=

# -----------------------------------------------------------------------------
# OPTIONAL - Database Configuration
# -----------------------------------------------------------------------------

# Path to SQLite database file (default: db.sqlite in working directory).
# Leave this commented out for Docker: the image defaults it to /app/data/db.sqlite,
# which is the mounted volume, and a value set here would override that through
# --env-file and put the database somewhere that is discarded on recreation.
#DATABASE_PATH=db.sqlite

# Embed color in decimal (default: 7980240 = #499999)
EMBED_COLOR=7980240

# -----------------------------------------------------------------------------
# OPTIONAL - Server Update Configuration
# -----------------------------------------------------------------------------

# How often to query the servers, update the embeds and check for map changes,
# in that order, all on this one interval (seconds)
SERVER_UPDATE_INTERVAL=90

# Maximum concurrent server queries
MAX_CONCURRENT_QUERIES=10

# -----------------------------------------------------------------------------
# OPTIONAL - Health Endpoint
# -----------------------------------------------------------------------------

# HTTP liveness endpoint at GET /health, for the container's HEALTHCHECK.
# 0 opens no socket. Leave both commented out for Docker: the image sets 3000,
# and a value here would override it through --env-file.
#HEALTH_PORT=0

# Bind address. Loopback keeps it inside the container. Change it only for an
# external monitor, and publish the port to match.
#HEALTH_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# OPTIONAL - Cache Configuration
# -----------------------------------------------------------------------------

# User cache TTL (seconds)
USER_CACHE_TTL=300

# -----------------------------------------------------------------------------
# OPTIONAL - Retry Configuration
# -----------------------------------------------------------------------------

# Maximum retry attempts for failed operations
RETRY_MAX_RETRIES=3

# Base delay for exponential backoff (seconds)
RETRY_BASE_DELAY=1

# Maximum retries for GameDig server queries. This is a multiplier over the ports
# GameDig tries, so raising it multiplies the time an unreachable server costs. A
# refresh pass is capped at 80% of SERVER_UPDATE_INTERVAL either way, and servers not
# reached by then are shown offline for that tick.
GAMEDIG_MAX_RETRIES=4

# -----------------------------------------------------------------------------
# OPTIONAL - Image URLs
# -----------------------------------------------------------------------------

# Fallback avatar URL for users without profile pictures
FALLBACK_AVATAR_URL=https://i.imgur.com/cBiDnMi.png

# Image for offline servers
OFFLINE_SERVER_IMAGE=https://i.imgur.com/WnS0Biz.png

# -----------------------------------------------------------------------------
# OPTIONAL - Map Image
# -----------------------------------------------------------------------------

# Base URL for map thumbnail images, applied to every map as `<base><mapname>.jpg`.
# Leave blank to disable map images entirely.
MAP_IMAGE_BASE_URL=https://bans.snksrv.com/images/maps/

# -----------------------------------------------------------------------------
# OPTIONAL - Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Maximum follow commands per minute per user
RATE_LIMIT_FOLLOW_PER_MINUTE=5

# Maximum unfollow commands per minute per user
RATE_LIMIT_UNFOLLOW_PER_MINUTE=5

# Maximum map-change DMs per minute per user. Repeats of the same map (one map on
# two servers) are always collapsed into one DM and never count against this.
RATE_LIMIT_NOTIFICATION_PER_MINUTE=10

# -----------------------------------------------------------------------------
# OPTIONAL - Follow Limits
# -----------------------------------------------------------------------------

# Maximum maps a single user may follow at once. Existing follows above the cap
# are kept; the user simply cannot add more until they unfollow something.
MAX_FOLLOWS_PER_USER=50

# -----------------------------------------------------------------------------
# OPTIONAL - Notification Fanout
# -----------------------------------------------------------------------------

# Maximum users DMed for a single map change. Beyond this the fanout is truncated
# and a warning naming the count is logged, rather than dropping people silently.
MAX_NOTIFICATION_RECIPIENTS=200

